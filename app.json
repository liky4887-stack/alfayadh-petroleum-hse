{
  "expo": {
    "name": "Alfayadh Petroleum HSE",
    "slug": "alfayadh-petroleum-hse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alfayadh.hse"
    },
    "android": {
      "package": "com.alfayadh.hse",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Alfayadh HSE to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alfayadh HSE to access your photos for safety reports."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash_blank.png",
          "imageWidth": 1,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6d7c36a8-0a9c-4a77-a5e1-002e4af38229"
      }
    },
    "owner": "liky488",
    "icon": "./assets/icon.png"
  }
}